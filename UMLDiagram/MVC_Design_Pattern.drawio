        <mxCell id="9XaYjXaACS19AIddBPfa-25" value="It&#39;s frontend application, User interact here.&lt;div&gt;Dumb class : No logic present here.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;" vertex="1" parent="1">
          <mxGeometry x="125" y="410" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="9XaYjXaACS19AIddBPfa-26" value="Accept user&#39;s request, interpratate, Business logic,&amp;nbsp;&lt;div&gt;It&#39;s brain of application.&amp;nbsp;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;" vertex="1" parent="1">
          <mxGeometry x="336" y="410" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="9XaYjXaACS19AIddBPfa-27" value="It&#39;s containing Class, Getter Setter and Validations, hold Data like Entity etc. Dumb class : No logic process here." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="9XaYjXaACS19AIddBPfa-31" value="Notes :&amp;nbsp;&lt;div&gt;1. POJO - Plain Old Java Object : No any special restriction i.e. not depend on any framework or library.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="-140" y="500" width="170" height="230" as="geometry" />
        </mxCell>
        <mxCell id="9XaYjXaACS19AIddBPfa-32" value="&lt;font size=&quot;1&quot;&gt;Advantage :&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font size=&quot;1&quot;&gt;1. Model Controller are decoupled, easy to maintain, easy to test.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;1&quot;&gt;2. Models are light weight, no heavay logic,&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;1&quot;&gt;3. Very useful for Mid or large enterprise application, not recommended for small application.&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="100" y="500" width="170" height="230" as="geometry" />
